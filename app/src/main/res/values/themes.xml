<resources>
    <!-- Base application theme (Light Mode). -->
    <style name="Theme.WaterManager" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/water_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/warning_orange</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <!-- Customize your theme here. -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Dark Mode Theme -->
    <style name="Theme.WaterManager.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/water_blue_light</item>
        <item name="colorOnPrimary">@color/dark_on_primary</item>
        <item name="colorSecondary">@color/warning_orange</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorTertiary">@color/extra_hydrated_green</item> <!-- Added for "extra hydrated" state -->
        <item name="android:background">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_on_surface</item>
        <item name="android:statusBarColor">@color/dark_background</item>
    </style>

    <!-- Style for the calendar date text -->
    <style name="CalendarDateText" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- Style for the calendar header text (Month and Year) -->
    <style name="CalendarHeaderText" parent="TextAppearance.AppCompat.Large">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- Style for the calendar week day text (Mon, Tue, etc.) -->
    <style name="CalendarWeekDayText" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">@android:color/white</item>
    </style>
</resources>
